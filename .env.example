# Required for Telegram delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CoinDCX public USDT-margined perpetual futures market data.
# No exchange API key/secret and no trading permissions are used.

# Runtime
SCAN_INTERVAL_SECONDS=60
CONCURRENCY=8
TIMEFRAME=5m
CONTEXT_TIMEFRAME=15m
ADX_MIN=25
RSI_PERIOD=14
ADX_PERIOD=14
EMA_FAST=9
EMA_SLOW=21
SIGNAL_COOLDOWN_CANDLES=3
MIN_RISK_REWARD=1.5
ATR_STOP_MULTIPLIER=1.5
LOG_LEVEL=INFO

# PostgreSQL connection string (Render internal database URL preferred)
DATABASE_URL=postgresql://user:password@host:5432/database
