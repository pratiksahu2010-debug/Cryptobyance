# Required for Telegram delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CoinDCX public USDT-margined perpetual futures market data.
# No exchange API key/secret and no trading permissions are used.

# Runtime
SCAN_INTERVAL_SECONDS=60
CONCURRENCY=8
TIMEFRAME=5m
CONTEXT_TIMEFRAME=15m
ADX_MIN=20
RSI_PERIOD=14
ADX_PERIOD=14
RSI_LONG_MIN=52
RSI_LONG_MAX=70
RSI_SHORT_MIN=30
RSI_SHORT_MAX=42
# 15m RSI is confidence-only; it never blocks a valid 5m trigger.
CONTEXT_RSI_MIDLINE=50
# Production scanner: prior swing stop with TP1_R / TP2_R targets.
SWING_LOOKBACK_BARS=10
TP1_R=1
TP2_R=2
EMA_FAST=9
EMA_SLOW=21
SIGNAL_COOLDOWN_CANDLES=4
# Legacy evaluate_signal() compatibility helper only; these do not affect production alerts.
MIN_RISK_REWARD=1.5
ATR_STOP_MULTIPLIER=1.5
# Forward outcome measurement: 12 completed 5m bars = 1 hour.
OUTCOME_HORIZON_BARS=12
# Estimated round-trip cost as percent of entry notional (0.10 = 0.10%).
OUTCOME_COST_PCT=0.10
# Offline trainer safeguards; insufficient samples never produce a proposal.
TRAINING_MIN_SAMPLES=100
TRAINING_MIN_BUCKET_SAMPLES=30
LOG_LEVEL=INFO

# PostgreSQL connection string (Neon pooled URL is supported; require TLS with sslmode=require)
DATABASE_URL=postgresql://user:password@host:5432/database

# Private access token for /journal and /learning APIs (generate a long random value)
JOURNAL_API_TOKEN=

# Telegram webhook secret for inline-button feedback callbacks
TELEGRAM_WEBHOOK_SECRET=
