# Runtime
SCAN_INTERVAL_SECONDS=60
CONCURRENCY=8
TIMEFRAME=5m
CONTEXT_TIMEFRAME=15m
SYMBOL_LIMIT=60
ADX_MIN=17
RSI_PERIOD=14
ADX_PERIOD=14
EMA_FAST=9
EMA_SLOW=21
SIGNAL_COOLDOWN_CANDLES=3
MIN_RISK_REWARD=1.5
ATR_STOP_MULTIPLIER=1.5
LOG_LEVEL=INFO
