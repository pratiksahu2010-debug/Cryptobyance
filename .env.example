# Required for Telegram delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CoinDCX public USDT-margined perpetual futures market data.
# No exchange API key/secret and no trading permissions are used.

# Runtime
SCAN_INTERVAL_SECONDS=60
CONCURRENCY=8
TIMEFRAME=5m
CONTEXT_TIMEFRAME=15m
ADX_MIN=20
RSI_PERIOD=14
ADX_PERIOD=14
RSI_LONG_MIN=52
RSI_LONG_MAX=70
RSI_SHORT_MIN=30
RSI_SHORT_MAX=42
EMA_FAST=9
EMA_SLOW=21
SIGNAL_COOLDOWN_CANDLES=4
MIN_RISK_REWARD=1.5
ATR_STOP_MULTIPLIER=1.5
LOG_LEVEL=INFO

# PostgreSQL connection string (Neon pooled URL is supported; require TLS with sslmode=require)
DATABASE_URL=postgresql://user:password@host:5432/database

# Private access token for /journal and /learning APIs (generate a long random value)
JOURNAL_API_TOKEN=

# Telegram webhook secret for inline-button feedback callbacks
TELEGRAM_WEBHOOK_SECRET=
